# --- device ---
DEVICE_ID=marcos-01
DEVICE_TOKEN=change-me
GATEWAY_URL=ws://localhost:8000/ws
# trecho do nome (ex.: Fifine) ou indice numerico; vazio = padrao do sistema.
# `python -m sounddevice` lista os dispositivos.
AUDIO_INPUT_DEVICE=
AUDIO_OUTPUT_DEVICE=
DISPLAY_MODE=window

# O rosto (D27). Mesma porta serve a pagina e o WebSocket dela.
# FACE_ENABLED=0 sobe o aparelho sem tela nenhuma.
FACE_PORT=8080
FACE_ENABLED=1
# Qual rosto: minimo (dois retangulos) ou anime
FACE_THEME=minimo

# STT local (decisao D1): tamanho small acerta, base cabe com folga (D9)
STT_MODEL=small
STT_COMPUTE_TYPE=int8
STT_MODEL_DIR=lab/models/faster-whisper
# quanto silencio encerra a fala, e o quanto o VAD e agressivo (0-3)
VAD_SILENCE_MS=700
VAD_AGGRESSIVENESS=3

# a voz do assistente: sintese roda no dispositivo (decisao D1)
TTS_VOICE=pt_BR-ideraldo-medium
TTS_VOICE_DIR=lab/models/piper
# simulated network latency: 80 = wifi, 150 = 4G
SIMULATED_LATENCY_MS=0

# timers e alarmes: em disco, para sobreviver a um reinicio (fase 2)
SCHEDULES_DB=device/data/schedules.db

# --- gateway ---
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000

# ollama (local, no key) | swap for a cloud provider later
LLM_PROVIDER=ollama
# qwen3:8b, e nao llama3.1:8b: com ferramentas declaradas o llama para de
# responder conhecimento geral (D19/D20). `ollama pull qwen3:8b`.
LLM_MODEL=qwen3:8b
# o qwen3 raciocina por padrao: lento para voz, e o rascunho pode virar fala
LLM_THINK=false
OLLAMA_URL=http://localhost:11434
# segundos: suba se o modelo local estiver sem GPU livre
LLM_TIMEOUT=120

# --- spotify (opcional) ---
# Sem estas duas, as ferramentas de musica nao sao oferecidas ao modelo.
# App em https://developer.spotify.com/dashboard; exige conta Premium para
# controlar playback. Depois de preencher, rode uma vez:
#   python -m gateway.tools.spotify_auth
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# tem que bater EXATAMENTE com o cadastrado no dashboard (127.0.0.1, nao localhost)
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
SPOTIFY_TOKEN_PATH=gateway/data/spotify_token.json
SPOTIFY_MARKET=BR
# Onde tocar quando ninguem disser onde. Aponta para a propria Pi rodando
# raspotify/librespot -- e o que faz o Marcos ser a caixa de som, e nao um
# controle remoto do PC. Enquanto a Pi nao existe, nao casa com nada e a escolha
# cai para o aparelho que estiver ativo.
# Tem que ser a MESMA string do LIBRESPOT_NAME em /etc/raspotify/conf na Pi --
# e a unica coisa que liga um ao outro. O casamento e por nome, nunca por id:
# o device_id que a API devolve nao sobrevive a um reboot.
SPOTIFY_DEVICE=Marcos

# --- busca na internet ---
# duckduckgo (padrao, sem chave) | brave (precisa de SEARCH_API_KEY) | none
SEARCH_PROVIDER=duckduckgo
SEARCH_API_KEY=
SEARCH_REGION=br-pt
# Abrir o primeiro resultado e ler o texto da pagina, alem do trecho de 400
# caracteres que o buscador devolve. Desligado por padrao: medido em 03/09/2026,
# o trecho ja respondia as 4 perguntas testadas, e a leitura custou de 1 a 3 s
# no turno mais lento que existe (D28). SEARCH_READ_PAGE=1 liga.
SEARCH_READ_PAGE=0

# only needed if STT or LLM move to cloud providers
LLM_API_KEY=
STT_API_KEY=
