# --- device ---
DEVICE_ID=ideraldinho-01
DEVICE_TOKEN=change-me
GATEWAY_URL=ws://localhost:8000/ws
# trecho do nome (ex.: Fifine) ou indice numerico; vazio = padrao do sistema.
# `python -m sounddevice` lista os dispositivos.
AUDIO_INPUT_DEVICE=
AUDIO_OUTPUT_DEVICE=
DISPLAY_MODE=window

# O rosto (D27). Mesma porta serve a pagina e o WebSocket dela.
# FACE_ENABLED=0 sobe o aparelho sem tela nenhuma.
FACE_PORT=8080
FACE_ENABLED=1
# Qual rosto: minimo (dois retangulos) ou anime
FACE_THEME=minimo

# STT local (decisao D1): tamanho small acerta, base cabe com folga (D9)
STT_MODEL=small
STT_COMPUTE_TYPE=int8
STT_MODEL_DIR=lab/models/faster-whisper
# quanto silencio encerra a fala, e o quanto o VAD e agressivo (0-3)
# Palavra de ativacao (Fase 7). O modelo do "Ideraldinho" existe (v3, D31), mas
# e um binario fora do git: o padrao nao pode apontar para um arquivo que um
# clone novo nao tem. Por isso vem desligada, e o padrao de WAKE_MODEL e um dos
# nomes que vem prontos com o openWakeWord ("alexa", "hey_jarvis",
# "hey_mycroft", "hey_rhasspy") -- serve para testar o encanamento, nao para
# uso: acordar o aparelho por outro nome e pior que nao ter wake word.
# Para o modelo de verdade, treine (lab/wakeword/README.md) e troque para:
#   WAKE_ENABLED=1
#   WAKE_MODEL=lab/models/wakeword/ideraldinho.onnx
#   WAKE_THRESHOLD=0.9
# O threshold nao se escolhe no codigo -- rode `python -m scripts.wake` e veja
# a pontuacao subir na sua sala (D30).
WAKE_ENABLED=0
WAKE_MODEL=hey_jarvis
WAKE_THRESHOLD=0.5
# Quando o assistente faz uma pergunta ("Qual eu cancelo?"), o microfone reabre
# por estes segundos sem exigir o nome, e a fala seguinte e tratada como a
# resposta. Passou o tempo em silencio, volta a esperar o nome.
REPLY_WINDOW_S=8

VAD_SILENCE_MS=700
VAD_AGGRESSIVENESS=3

# a voz do assistente: sintese roda no dispositivo (decisao D1)
TTS_VOICE=pt_BR-ideraldo-medium
TTS_VOICE_DIR=lab/models/piper
# simulated network latency: 80 = wifi, 150 = 4G
SIMULATED_LATENCY_MS=0

# timers e alarmes: em disco, para sobreviver a um reinicio (fase 2)
SCHEDULES_DB=device/data/schedules.db

# --- gateway ---
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000

# ollama (local, sem chave) | openai-compat (qualquer API no formato Chat
# Completions da OpenAI -- ver o bloco "LLM na nuvem" logo abaixo)
LLM_PROVIDER=ollama
# qwen3:8b, e nao llama3.1:8b: com ferramentas declaradas o llama para de
# responder conhecimento geral (D19/D20). `ollama pull qwen3:8b`.
LLM_MODEL=qwen3:8b
# o qwen3 raciocina por padrao: lento para voz, e o rascunho pode virar fala
LLM_THINK=false
OLLAMA_URL=http://localhost:11434
# segundos: suba se o modelo local estiver sem GPU livre
LLM_TIMEOUT=120
# LLM na nuvem: LLM_PROVIDER=openai-compat serve a OpenAI, Gemini, Groq,
# Cerebras, DeepSeek, Mistral, OpenRouter e ao /v1 do proprio Ollama. A chave e
# LLM_API_KEY (no fim deste arquivo). O endereco vai ate o /v1 ou equivalente;
# o gateway acrescenta /chat/completions:
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_BASE_URL=https://api.openai.com/v1
# Com LLM_PROVIDER=ollama, LLM_BASE_URL vazio cai em OLLAMA_URL.
LLM_BASE_URL=
# Raciocinio desligado ou no minimo (D20): custa segundos e pode virar fala. Vai
# no pedido como `reasoning_effort` SO se preenchido: o valor aceito muda por
# provedor e por modelo (none, minimal, low), e quem nao conhece o campo
# devolve 400. Confira na documentacao do modelo escolhido.
LLM_REASONING_EFFORT=
# Vazio = o padrao do provedor.
LLM_TEMPERATURE=
# Um objeto JSON somado ao corpo do pedido, para o que nao tem variavel propria:
#   LLM_EXTRA_BODY='{"parallel_tool_calls": false}'
LLM_EXTRA_BODY=
# Reserva: quem responde quando o principal nao responde (fora do ar, erro HTTP,
# ou LLM_FIRST_DELTA_TIMEOUT segundos sem comecar a responder). Vazio = sem
# reserva. Aceita os mesmos sufixos do principal: LLM_FALLBACK_PROVIDER,
# _BASE_URL, _API_KEY, _MODEL, _REASONING_EFFORT, _TEMPERATURE, _EXTRA_BODY.
# Principal na nuvem e, de reserva, o Ollama de casa por tunel:
#   LLM_FALLBACK_PROVIDER=ollama
#   LLM_FALLBACK_BASE_URL=http://100.64.0.2:11434
#   LLM_FALLBACK_MODEL=qwen3:8b
LLM_FALLBACK_PROVIDER=
LLM_FIRST_DELTA_TIMEOUT=8

# --- spotify (opcional) ---
# Sem estas duas, as ferramentas de musica nao sao oferecidas ao modelo.
# App em https://developer.spotify.com/dashboard; exige conta Premium para
# controlar playback. Depois de preencher, rode uma vez:
#   python -m gateway.tools.spotify_auth
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# tem que bater EXATAMENTE com o cadastrado no dashboard (127.0.0.1, nao localhost)
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
SPOTIFY_TOKEN_PATH=gateway/data/spotify_token.json
SPOTIFY_MARKET=BR
# Onde tocar quando ninguem disser onde. Aponta para a propria Pi rodando
# raspotify/librespot -- e o que faz o Ideraldinho ser a caixa de som, e nao um
# controle remoto do PC. Enquanto a Pi nao existe, nao casa com nada e a escolha
# cai para o aparelho que estiver ativo.
# Tem que ser a MESMA string do LIBRESPOT_NAME em /etc/raspotify/conf na Pi --
# e a unica coisa que liga um ao outro. O casamento e por nome, nunca por id:
# o device_id que a API devolve nao sobrevive a um reboot.
SPOTIFY_DEVICE=Ideraldinho

# --- busca na internet ---
# duckduckgo (padrao, sem chave) | brave (precisa de SEARCH_API_KEY) | none
SEARCH_PROVIDER=duckduckgo
SEARCH_API_KEY=
SEARCH_REGION=br-pt
# Abrir o primeiro resultado e ler o texto da pagina, alem do trecho de 400
# caracteres que o buscador devolve. Desligado por padrao: medido em 03/09/2026,
# o trecho ja respondia as 4 perguntas testadas, e a leitura custou de 1 a 3 s
# no turno mais lento que existe (D28). SEARCH_READ_PAGE=1 liga.
SEARCH_READ_PAGE=0

# --- financas por voz (opcional) ---
# O endereco do servidor MCP do app de financas (ex.: https://app.example.com/mcp).
# Vazio = nenhuma ferramenta de dinheiro e oferecida ao modelo. Depois de
# preencher, rode uma vez NO COMPUTADOR (precisa de navegador, nao na VPS):
#   python -m gateway.tools.financas_auth
# O arquivo de token da acesso as financas inteiras: fica fora do git e da imagem.
FINANCAS_MCP_URL=
FINANCAS_TOKEN_PATH=gateway/data/financas_token.json
# So se o servidor nao aceitar registro dinamico de cliente / exigir escopo.
FINANCAS_CLIENT_ID=
FINANCAS_SCOPE=
FINANCAS_REDIRECT_URI=http://127.0.0.1:8765/callback

# only needed if STT or LLM move to cloud providers
LLM_API_KEY=
STT_API_KEY=
